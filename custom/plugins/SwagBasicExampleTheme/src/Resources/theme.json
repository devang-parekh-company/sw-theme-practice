{
  "name": "Custom Theme",
  "author": "Custom Theme author",
  "views": ["@Storefront", "@Plugins", "@SwagBasicExampleTheme"],
  "style": [
    "app/storefront/src/scss/overrides.scss",
    "@Storefront",
    "app/storefront/src/scss/base.scss"
  ],
  "script": [
    "@Storefront",
    "app/storefront/dist/storefront/js/swag-basic-example-theme/swag-basic-example-theme.js"
  ],
  "asset": ["@Storefront", "app/storefront/src/assets"],
  "config": {
    "blocks": {
      "exampleBlock": {
        "label": {
          "en-GB": "example block",
          "de-DE": "Beispiel Block"
        }
      }
    },
    "sections": {
      "exampleSection": {
        "label": {
          "en-GB": "example section",
          "de-DE": "Beispiel Sektion"
        }
      }
    },
    "fields": {
      "redirect-url": {
        "label": {
          "en-GB": "Redirect URL",
          "de-DE": "Redirect URL"
        },
        "type": "url",
        "block": "exampleBlock",
        "section": "exampleSection",
        "scss": false
      }
    }
  }
}
