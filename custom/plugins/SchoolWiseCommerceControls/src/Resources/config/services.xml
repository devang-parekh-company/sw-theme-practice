<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <service id="SchoolWiseCommerceControls\Service\CustomFieldsInstaller">
            <argument type="service" id="custom_field_set.repository"/>
            <argument type="service" id="custom_field_set_relation.repository"/>
        </service>

        <service id="SchoolWiseCommerceControls\Subscriber\RegisterFormSubscriber">
            <argument type="service" id="customer_group.repository" />
            <argument type="service" id="customer.repository" />
            <argument type="service" id="request_stack"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>
            <tag name="kernel.event_subscriber" />
        </service>

        <service id="SchoolWiseCommerceControls\Controller\CustomerGroupController"
                 public="true">
            <argument type="service" id="customer_group.repository"/>
            <argument type="service" id="router" />
            <tag name="controller.service_arguments"/>
        </service>

        <!--  SchoolLicenceInformation Definition  -->
        <service id="SchoolWiseCommerceControls\Core\Content\SchoolLicenceInformation\SchoolLicencesInformationDefinition">
            <tag name="shopware.entity.definition" entity="school_licences_information"/>
        </service>
        <!--  SchoolLicenceInformation Definition  -->

        <!--  Extension  -->
        <service id="SchoolWiseCommerceControls\Core\Content\Extension\ProductExtension">
            <tag name="shopware.entity.extension"/>
        </service>
        <service id="SchoolWiseCommerceControls\Core\Content\Extension\CategoryExtension">
            <tag name="shopware.entity.extension"/>
        </service>
        <service id="SchoolWiseCommerceControls\Core\Content\Extension\CustomerGroupExtension">
            <tag name="shopware.entity.extension"/>
        </service>
        <!--  Extension  -->

        <service id="SchoolWiseCommerceControls\Controller\SchoolLicenceInformationController" public="true">
            <argument type="service" id="school_licences_information.repository"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="SchoolWiseCommerceControls\Storefront\Controller\CartLineItemControllerDecorator"
                 decorates="Shopware\Storefront\Controller\CartLineItemController"
                 parent="Shopware\Storefront\Controller\CartLineItemController"
                 public="true">
                <argument type="service" id=".inner"/>
                <argument type="service" id="school_licences_information.repository"/>
                <argument type="service" id="product.repository"/>
                <argument type="service" id="customer_group.repository" />
                <call method="setContainer">
                    <argument type="service" id="service_container"/>
                </call>
                <call method="setTwig">
                    <argument type="service" id="twig"/>
                </call>
        </service>

        <service id="SchoolWiseCommerceControls\Subscriber\AddtoCartSubscriber">
            <argument type="service" id="school_licences_information.repository" />
            <argument type="service" id="product.repository"/>
            <tag name="kernel.event_subscriber" />
        </service>

        <service id="SchoolWiseCommerceControls\Subscriber\ShippingAddressSubscriber">
            <argument type="service" id="customer_group.repository" />
            <argument type="service" id="customer_address.repository" />
            <argument type="service" id="salutation.repository" />
            <argument type="service" id="customer.repository" />
            <argument type="service" id="country.repository" />
            <argument type="service" id="sales_channel_country.repository"/>
            <tag name="kernel.event_subscriber" />
        </service>

    </services>
</container>