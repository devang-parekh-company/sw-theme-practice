{
  "name": "cms-plugin/cms-plugin",
  "description": "This is my first plugin used for CMS block creation.",
  "type": "shopware-platform-plugin",
  "version": "1.0.0",
  "license": "MIT",
  "require": {
    "shopware/core": "~6.6.0"
  },
  "extra": {
    "shopware-plugin-class": "CmsPlugin\\CmsPlugin",
    "label": {
